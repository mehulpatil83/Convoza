# ==============================================================================
# Convoza — Environment Variables Reference
# Add these to Vercel (Project Settings > Environment Variables)
# ==============================================================================

# ── AI Provider (Gemma 4 via Google GenAI) ────────────────────────────────────
# Required. Set to 'gemini' for production cloud inference.
LLM_PROVIDER=gemini

# Required. Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required. The exact Gemma 4 model identifier.
GEMMA_MODEL=gemma-4-26b-a4b-it


# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Required for WhatsApp bot integration.
# From Meta for Developers (https://developers.facebook.com/apps)

# Meta System User Access Token with 'whatsapp_business_messaging' permission
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Phone Number ID (from WhatsApp > API Setup in Meta dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_WABA_ID=your_waba_id_here

# Meta App Secret (Settings > Basic in Meta dashboard) used for HMAC-SHA256 signature verification
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Custom secret token you choose. Enter the EXACT same string in Meta Webhook config
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta Graph API version (default: v21.0)
WHATSAPP_GRAPH_API_VERSION=v21.0


# ── Supabase (Durable Storage & Idempotency) ──────────────────────────────────
# Optional for local development, recommended for Vercel production.
# Enables durable message deduplication and persistent order candidates across serverless restarts.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
